# ===========================================
# Email Filter System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# VPS API Configuration
# ===========================================

# Server port for the API service
# Note: config.ts reads PORT (not API_PORT); docker-compose.yml also uses PORT.
PORT=3000

# API authentication token (generate a secure random string)
# Used by Email Worker to authenticate webhook requests
API_TOKEN=your-secure-api-token-here

# Default email address to forward emails when no rules match
DEFAULT_FORWARD_TO=your-email@gmail.com

# Database path (for systemd deployment)
DB_PATH=/opt/email-filter/data/filter.db

# Public URL of this VPS API (used to check if workers are connected to this VPS)
# Example: https://your-domain.com or http://your-ip:3000
VPS_PUBLIC_URL=http://your-vps-ip:3000

# ===========================================
# JWT Authentication Configuration
# ===========================================

# Secret key for signing JWT tokens (CHANGE IN PRODUCTION!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production

# Token expiration time (default: 24h)
# Supported formats: 1h, 24h, 7d, etc.
JWT_EXPIRY=24h

# Default admin credentials (used on first startup when no users exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password-in-production

# ===========================================
# Admin Panel Configuration
# ===========================================
# The admin panel is served by vps-api at /admin on the same host and port as the API.
# Example: https://your-vps-domain.com/admin or http://your-vps-ip:3000/admin

# ===========================================
# Feature Flags
# ===========================================

# Enable/disable campaign analytics routes and async processing.
CAMPAIGN_ANALYTICS_ENABLED=true

# Enable/disable signal monitoring routes and heartbeat scheduler.
SIGNAL_MONITORING_ENABLED=true

# Enable/disable subject tracking routes and background collection.
SUBJECT_TRACKING_ENABLED=true

# Note: Dynamic rule parameters (time window / threshold / expiration / enable)
# are NOT read from environment variables. They are configured at runtime via the
# /api/dynamic endpoints and stored in the dynamic_config table
# (see DynamicRuleService.getConfig()). Do not add DYNAMIC_* env vars here.

# ===========================================
# Extraction Worker Configuration (optional)
# ===========================================
# vps-api proxies these to query verification/discount codes stored in
# extraction-worker's D1, and pushes extraction rule configs on rule save.
# Leave empty to disable the admin panel's extraction views (email forwarding
# and extraction itself still work — they don't depend on these vars).
EXTRACTION_WORKER_URL=https://extraction-worker.your-account.workers.dev
EXTRACTION_WORKER_TOKEN=same-as-extraction-worker-ADMIN_TOKEN

# ===========================================
# Scheduler Configuration
# ===========================================

# Cron expression for signal-monitoring heartbeat checks (default: every 5 minutes)
HEARTBEAT_CRON=*/5 * * * *

# Cron expression for data cleanup (default: daily at 3 AM)
CLEANUP_CRON=0 3 * * *

# Hours to retain hit logs (default: 72, range: 48-72)
HIT_LOG_RETENTION_HOURS=72

# Days to retain alerts (default: 90, range: 30-90)
ALERT_RETENTION_DAYS=90

# Whether to run a heartbeat check immediately on server start (default: false)
RUN_HEARTBEAT_ON_START=false

# ===========================================
# Cloudflare Email Worker Configuration
# ===========================================
# These are configured in wrangler.toml, not here
# VPS_API_URL=https://your-vps-domain.com/api/webhook/email
# VPS_API_TOKEN=same-as-API_TOKEN-above

# ===========================================
# Production Settings
# ===========================================

# Node environment
NODE_ENV=production

# Server host binding
HOST=0.0.0.0
